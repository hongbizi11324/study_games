# Unity .gitignore
# 最新版本: https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# 内存捕获和录制文件可能很大
[Mm]emoryCaptures/
[Rr]ecordings/

# JetBrains Rider 自动生成的插件
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio 缓存
.vs/

# Gradle 缓存
.gradle/

# 自动生成的 VS/MD 解决方案和项目文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 自动生成的 meta 文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃报告
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables 打包数据
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android 临时资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 系统文件
.DS_Store
Thumbs.db

# CodeLY / 团结引擎 AI 插件
.codely-cli/
.codely/
.codelyignore
.com-unity-codely.json
CODELY.md
Assets/Codely/
Assets/Codely.meta

# Unity Plastic SCM 元数据
.plastic/

# VS Code 工作区设置
.vscode/
.vsconfig

# TextMesh Pro 官方示例/文档（非游戏内容，体积大，导入即带）
Assets/TextMesh Pro/Examples & Extras/
Assets/TextMesh Pro/Documentation/
